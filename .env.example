# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local al repo.
#
# Públicas (van al navegador). Son las únicas que deben estar en Preview en Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SECRETAS. En Vercel, solo en Production y marcadas como Sensitive.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
RESEND_API_KEY=re_xxx
CRON_SECRET=generate-with-openssl-rand-hex-32

# SECRETA y solo local: la usa drizzle-kit para las migraciones. No debe estar en Vercel.
DIRECT_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# No secretas.
ADMIN_EMAIL=you@example.com
RESEND_FROM="Portal <portal@angel-fernandez.es>"

# Formulario de contacto (Resend)
# Remitente de un dominio verificado en Resend
CONTACT_FROM=
# Destino de los mensajes (opcional, por defecto tecnico@angel-fernandez.es)
CONTACT_TO=
